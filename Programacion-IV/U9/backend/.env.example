# Copiar como .env y generar una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///foodstore_u9.db
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_GENERADA
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
# Opcional: crea el administrador inicial, sin publicar su contraseña.
ADMIN_EMAIL=
ADMIN_PASSWORD=
